{
  "schema_version": "0.1",
  "agent": {
    "id": "portfolio_risk_guard",
    "name": "A 股持仓风险管家",
    "description": "读取用户提供的 A 股持仓，计算集中度、波动率、回撤、相关性和明确指定的压力情景。",
    "version": "0.1.0"
  },
  "runtime": {
    "pattern_id": "plan_and_execute",
    "compiled_pattern_id": null,
    "user_config": {},
    "agent_config": {
      "agent_id": "portfolio_risk_guard",
      "activation": {
        "workflow_goal": "基于用户明确提供的 A 股持仓和风险要求完成可复核的组合风险分析。",
        "start_when": "用户要求分析一组 A 股持仓、上传持仓文件或要求执行组合压力测试。",
        "ask_when_missing": "缺少持仓代码及统一的权重或持股数量，或用户要求阈值判断但未给出阈值时先询问。"
      }
    }
  },
  "graph_overrides": {"node_wrappers": []},
  "bindings": {
    "services": [],
    "node_bindings": [
      {
        "binding_id": "planner_prompt",
        "binding_type": "prompt",
        "target": {"node_id": "planner", "impl": "cognitive.answer"},
        "payload": {
          "prompt_id": "planner_prompt",
          "template": "你是 A 股持仓风险分析规划器。只使用 runtime_plan 制定步骤：确认持仓输入与计量方式、读取必要文件、计算组合指标、核对用户风险规则、执行用户明确指定的压力情景、形成风险报告。不得读取文件或调用分析工具。只处理六位代码 A 股；如果持仓没有统一提供 weight 或 shares，必须要求补充，不能自行猜测。",
          "variables": []
        }
      },
      {
        "binding_id": "planner_tool_access",
        "binding_type": "tool_access",
        "target": {"node_id": "planner", "impl": "cognitive.answer"},
        "payload": {"allowed_tool_ids": ["runtime_plan"], "approval_policy": "allow_all"}
      },
      {
        "binding_id": "planner_model_operation",
        "binding_type": "model_operation",
        "target": {"node_id": "planner", "impl": "cognitive.answer"},
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {"type": "object", "additionalProperties": true},
          "write_target": {"section": "context"},
          "max_attempts": 3,
          "prompt_id": "planner_prompt"
        }
      },
      {
        "binding_id": "executor_prompt",
        "binding_type": "prompt",
        "target": {"node_id": "executor", "impl": "cognitive.answer"},
        "payload": {
          "prompt_id": "executor_prompt",
          "template": "你是 A 股持仓风险分析执行器。严格执行 runtime_plan 当前步骤。进入第一个实质分析步骤时，先用 skill(action='load', name='a-share-portfolio-risk-analysis', current_system='portfolio_risk_guard', reason='执行 A 股持仓风险分析流程') 加载完整流程。持仓文件先用 read 读取，再把结构化 holdings 传给 analyze_a_share_portfolio；不要把文件路径冒充工具输入。工具只接受全部使用 weight 或全部使用 shares 的持仓。用户要求依据内部风险规范时必须先查询 knowledge，并引用命中来源；用户没有提供阈值时只报告原始指标，禁止擅自贴高风险或低风险标签。压力测试只使用用户明确给出的 stress_scenarios。可用 write 保存风险报告，scheduler 仅用于用户明确要求的后续复查提醒。不接券商、不执行交易、不承诺收益。",
          "variables": []
        }
      },
      {
        "binding_id": "executor_tool_access",
        "binding_type": "tool_access",
        "target": {"node_id": "executor", "impl": "cognitive.answer"},
        "payload": {
          "allowed_tool_ids": ["runtime_plan", "glob", "ls", "read", "write", "skill", "knowledge", "scheduler", "analyze_a_share_portfolio"],
          "approval_policy": "allow_all"
        }
      },
      {
        "binding_id": "executor_model_operation",
        "binding_type": "model_operation",
        "target": {"node_id": "executor", "impl": "cognitive.answer"},
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {"type": "object", "additionalProperties": true},
          "write_target": {"section": "context"},
          "max_attempts": 3,
          "prompt_id": "executor_prompt"
        }
      },
      {
        "binding_id": "casual_react_prompt",
        "binding_type": "prompt",
        "target": {"node_id": "casual_react", "impl": "cognitive.answer"},
        "payload": {
          "prompt_id": "casual_react_prompt",
          "template": "你是 A 股持仓风险管家。简短澄清可以直接回答；涉及具体组合指标必须调用 analyze_a_share_portfolio。没有用户阈值时不擅自划分风险等级，不处理港股、美股或交易执行。",
          "variables": []
        }
      },
      {
        "binding_id": "casual_react_tool_access",
        "binding_type": "tool_access",
        "target": {"node_id": "casual_react", "impl": "cognitive.answer"},
        "payload": {"allowed_tool_ids": ["glob", "ls", "read", "skill", "knowledge", "scheduler", "analyze_a_share_portfolio"], "approval_policy": "allow_all"}
      },
      {
        "binding_id": "casual_react_model_operation",
        "binding_type": "model_operation",
        "target": {"node_id": "casual_react", "impl": "cognitive.answer"},
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {"type": "object", "additionalProperties": true},
          "write_target": {"section": "context"},
          "max_attempts": 3,
          "prompt_id": "casual_react_prompt"
        }
      },
      {
        "binding_id": "final_answer_prompt",
        "binding_type": "prompt",
        "target": {"node_id": "final_answer", "impl": "cognitive.answer"},
        "payload": {
          "prompt_id": "final_answer_prompt",
          "template": "汇总已完成步骤，输出 A 股持仓风险报告：输入口径、数据时间与来源、持仓权重、集中度、组合收益与波动、最大回撤、个股风险指标、最高相关性组合、用户指定压力情景、资料规则引用、数据限制。只在用户提供明确阈值时按阈值判断，保留所有 warnings，不给确定性买卖指令。",
          "variables": []
        }
      },
      {
        "binding_id": "final_answer_tool_access",
        "binding_type": "tool_access",
        "target": {"node_id": "final_answer", "impl": "cognitive.answer"},
        "payload": {"allowed_tool_ids": ["glob", "ls", "read", "write", "skill", "knowledge", "scheduler", "analyze_a_share_portfolio"], "approval_policy": "allow_all"}
      },
      {
        "binding_id": "final_answer_model_operation",
        "binding_type": "model_operation",
        "target": {"node_id": "final_answer", "impl": "cognitive.answer"},
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {"type": "object", "additionalProperties": true},
          "write_target": {"section": "context"},
          "max_attempts": 3,
          "prompt_id": "final_answer_prompt"
        }
      }
    ],
    "hooks": []
  },
  "tools": [
    {
      "id": "analyze_a_share_portfolio",
      "description": "基于用户明确提供的 A 股持仓和前复权历史收盘价，计算持仓权重、集中度、组合收益、波动率、最大回撤、个股指标、相关性和用户指定压力情景。",
      "schema_error_guidance": "holdings 必须包含 1 到 20 个不重复的六位 A 股代码，并且全部使用 weight 或全部使用 shares；history_days 为 60 到 500；stress_scenarios 可选。",
      "entrypoint": "python:tools/analyze_a_share_portfolio/tool.py:run",
      "input_schema": {
        "type": "object",
        "properties": {
          "holdings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "code": {"type": "string", "pattern": "^[0-9]{6}$"},
                "weight": {"type": "number", "exclusiveMinimum": 0},
                "shares": {"type": "number", "exclusiveMinimum": 0},
                "cost_price": {"type": "number", "exclusiveMinimum": 0}
              },
              "required": ["code"],
              "additionalProperties": false,
              "oneOf": [
                {"required": ["weight"], "not": {"required": ["shares"]}},
                {"required": ["shares"], "not": {"required": ["weight"]}}
              ]
            }
          },
          "history_days": {"type": "integer", "minimum": 60, "maximum": 500, "default": 250},
          "stress_scenarios": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "number", "minimum": -50, "maximum": 50},
            "description": "用户明确指定的全组合价格冲击百分比，例如 -10。"
          }
        },
        "required": ["holdings"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["success", "partial", "error"]},
          "observed_at": {"type": "string"},
          "source": {"type": "string"},
          "adjustment": {"type": "string"},
          "weight_basis": {"type": "string", "enum": ["provided_weights", "latest_market_value"]},
          "portfolio": {"type": "object"},
          "holdings": {"type": "array", "items": {"type": "object"}},
          "highest_correlation": {"type": ["object", "null"]},
          "stress_results": {"type": "array", "items": {"type": "object"}},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string"}
        },
        "required": ["status", "observed_at", "source", "adjustment", "weight_basis", "portfolio", "holdings", "highest_correlation", "stress_results", "warnings", "message"],
        "additionalProperties": false
      },
      "resources": {},
      "risk_level": "low",
      "risk_evaluator": {"hard": null, "llm": null, "llm_mode": "disabled"},
      "concurrent": false,
      "permission_scope": "package",
      "permission_tags": ["read_only"],
      "output_compression": {"action_argument": "action", "actions": {}},
      "output_projection": "compress"
    }
  ],
  "output": {"citations_required": false, "format": "markdown"},
  "harness": [],
  "metadata": {
    "provenance": {"source": "system_package", "package_id": "portfolio_risk_guard"},
    "scope": "a_share_only"
  }
}
