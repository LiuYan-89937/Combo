{
  "version": "mcp_servers.v0",
  "servers": [
    {
      "server_id": "bigopen_llm_search",
      "transport": "stdio",
      "command": "node",
      "args": [
        "dist/index.js"
      ],
      "cwd": "../../.agentfactory/mcp/web_search",
      "env": {
        "SEARXNG_URL": "http://127.0.0.1:8888",
        "SEARXNG_AUTO_START": "true",
        "SEARXNG_DOCKER_PORT": "8888",
        "DEFAULT_SEARCH_ENGINE": "searxng",
        "NO_PROXY": "127.0.0.1,localhost",
        "no_proxy": "127.0.0.1,localhost"
      },
      "source": {
        "type": "local",
        "path": "../../.agentfactory/mcp/web_search",
        "url": "https://github.com/LiuYan-89937/WebSearchApi",
        "package": "bigopen-llm-search"
      },
      "enabled": true,
      "required": false,
      "tool_id_prefix": "bigopen",
      "risk_level_default": "medium",
      "tool_input_property_enums": {
        "web_search": {
          "engine": [
            "searxng",
            "duckduckgo"
          ]
        }
      },
      "timeout_seconds": 60
    }
  ]
}
