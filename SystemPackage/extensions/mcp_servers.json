{
  "version": "mcp_servers.v0",
  "servers": [
    {
      "server_id": "bigopen_llm_search",
      "transport": "stdio",
      "command": "node",
      "args": [
        "dist/index.js"
      ],
      "cwd": "../../.agentfactory/mcp/web_search",
      "env": {
        "SEARXNG_URL": "http://127.0.0.1:8888",
        "SEARXNG_AUTO_START": "true",
        "SEARXNG_DOCKER_PORT": "8888",
        "DEFAULT_SEARCH_ENGINE": "searxng",
        "NO_PROXY": "127.0.0.1,localhost",
        "no_proxy": "127.0.0.1,localhost"
      },
      "source": {
        "type": "local",
        "path": "../../.agentfactory/mcp/web_search",
        "url": "https://github.com/LiuYan-89937/WebSearchApi",
        "package": "bigopen-llm-search"
      },
      "enabled": true,
      "required": false,
      "tool_id_prefix": "bigopen",
      "risk_level_default": "medium",
      "tool_input_property_enums": {
        "web_search": {
          "engine": [
            "searxng",
            "duckduckgo"
          ]
        }
      },
      "tool_loop_policies": {
        "web_search": {
          "max_calls": 12,
          "max_identical_calls": 1,
          "max_semantic_calls": 2,
          "max_consecutive_failures": 3,
          "max_consecutive_empty_results": 3,
          "max_consecutive_no_new_evidence": 3,
          "semantic_argument_pointers": [
            "/query"
          ],
          "evidence_output_pointers": [
            "/results"
          ]
        }
      },
      "timeout_seconds": 60
    }
  ]
}
