{
  "schema_version": "0.1",
  "agent": {
    "id": "factory_chat",
    "name": "Factory Chat",
    "description": "FastAgentFactory built-in general-purpose Agent.",
    "version": "0.1.0"
  },
  "runtime": {
    "pattern_id": "react_agent",
    "compiled_pattern_id": null,
    "user_config": {},
    "agent_config": {
      "agent_id": "factory_chat"
    }
  },
  "graph_overrides": {
    "node_wrappers": []
  },
  "bindings": {
    "services": [],
    "node_bindings": [
      {
        "binding_id": "answer_prompt",
        "binding_type": "prompt",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "prompt_id": "answer_prompt",
          "template": "You are FastAgentFactory's general-purpose Agent. Answer normal chat directly in Chinese and complete work with the available tools. Use runtime tools only when needed. Prefer web search or extraction for static research and browser tools for interactive or dynamically rendered pages. Inspect a page with browser_snapshot before uncertain interactions, retain its page_id across related actions, use browser_screenshot only when visual inspection is necessary, and close browser contexts after the work is complete. When read reports a missing file or the path is uncertain, inspect the parent or nearby directory with ls before retrying read with the exact path.",
          "variables": []
        }
      },
      {
        "binding_id": "answer_tool_access",
        "binding_type": "tool_access",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "allowed_tool_ids": [
            "read",
            "write",
            "edit",
            "glob",
            "grep",
            "ls",
            "shell",
            "shell_status",
            "shell_stop",
            "knowledge",
            "scheduler",
            "skillhub",
            "background_tasks",
            "browser_open",
            "browser_snapshot",
            "browser_click",
            "browser_type",
            "browser_select",
            "browser_press",
            "browser_scroll",
            "browser_wait",
            "browser_extract",
            "browser_screenshot",
            "browser_download",
            "browser_upload",
            "browser_tabs",
            "browser_close"
          ],
          "approval_policy": "standard"
        }
      },
      {
        "binding_id": "answer_model_operation",
        "binding_type": "model_operation",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {
            "type": "object",
            "additionalProperties": true
          },
          "write_target": {
            "section": "context"
          },
          "max_attempts": 3,
          "prompt_id": "answer_prompt"
        }
      }
    ],
    "hooks": []
  },
  "tools": [],
  "output": {
    "citations_required": false,
    "format": "text"
  },
  "harness": [],
  "metadata": {
    "provenance": {
      "source": "system_package",
      "package_id": "factory_chat"
    }
  }
}
