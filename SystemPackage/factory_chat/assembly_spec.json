{
  "schema_version": "0.1",
  "agent": {
    "id": "factory_chat",
    "name": "Factory Chat",
    "description": "FastAgentFactory system chat assistant.",
    "version": "0.1.0"
  },
  "runtime": {
    "pattern_id": "react_agent",
    "compiled_pattern_id": null,
    "user_config": {},
    "agent_config": {
      "agent_id": "factory_chat"
    }
  },
  "graph_overrides": {
    "node_wrappers": []
  },
  "bindings": {
    "services": [],
    "node_bindings": [
      {
        "binding_id": "answer_prompt",
        "binding_type": "prompt",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "prompt_id": "answer_prompt",
          "template": "You are FastAgentFactory's shell assistant. Answer normal chat directly in Chinese. Be concise, warm, and practical. Use available runtime tools only when they are clearly needed for the user's request.",
          "variables": []
        }
      },
      {
        "binding_id": "answer_tool_access",
        "binding_type": "tool_access",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "allowed_tool_ids": [
            "knowledge",
            "scheduler"
          ],
          "approval_policy": "standard"
        }
      },
      {
        "binding_id": "answer_model_operation",
        "binding_type": "model_operation",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {
            "type": "object",
            "additionalProperties": true
          },
          "write_target": {
            "section": "context"
          },
          "max_attempts": 3,
          "prompt_id": "answer_prompt"
        }
      }
    ],
    "hooks": []
  },
  "tools": [],
  "output": {
    "citations_required": false,
    "format": "text"
  },
  "harness": [],
  "metadata": {
    "provenance": {
      "source": "system_package",
      "package_id": "factory_chat"
    }
  }
}
