{
  "type": "model",
  "version": "model_contract.v1",
  "enabled": true,
  "config": {
    "bindings": {
      "main": {
        "source": "env",
        "reason": "Use the host environment main chat model by default.",
        "required_capabilities": {
          "input_modalities": [
            "text"
          ],
          "output_modalities": [
            "text"
          ],
          "tool_calling": true,
          "structured_output_methods": [
            "json_mode",
            "function_calling"
          ]
        },
        "overrides": {}
      }
    },
    "tool_bindings": {
      "generate_image": {
        "source": "env",
        "capability": "image_output",
        "reason": "Use the host environment image model when configured.",
        "required_capabilities": {
          "output_modalities": [
            "image"
          ],
          "text_to_image": true
        },
        "overrides": {},
        "description": "Use Wanx to generate images from a text prompt."
      }
    }
  }
}
