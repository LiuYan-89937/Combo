{
  "type": "model",
  "version": "model_contract.v1",
  "enabled": true,
  "config": {
    "bindings": {
      "main": {
        "source": "local_default",
        "reason": "Use the configured default local ROCm chat profile.",
        "required_capabilities": {
          "input_modalities": [
            "text"
          ],
          "output_modalities": [
            "text"
          ],
          "tool_calling": true,
          "structured_output_methods": [
            "json_mode",
            "function_calling"
          ]
        },
        "overrides": {}
      }
    },
    "tool_bindings": {
      "generate_image": {
        "profile_id": "flux.1-dev-q4_0",
        "source": "local_registry",
        "capability": "image_output",
        "selection_source": "manual",
        "reason": "Use the configured FLUX.1-dev image profile for local text-to-image generation.",
        "required_capabilities": {
          "input_modalities": [
            "text"
          ],
          "output_modalities": [
            "image"
          ],
          "text_to_image": true
        },
        "overrides": {},
        "description": "调用本地 FLUX.1-dev 模型生成图片，并将结果保存为当前会话可访问的图片资产。FLUX 对英文提示词理解更稳定：当用户使用中文描述画面时，调用前必须在不改变用户意图的前提下，将主体、数量、动作、构图、风格、光照、色彩和约束忠实改写为清晰、具体的英文 prompt；只有用户明确要求画面出现中文文字时，相关文字内容才保留中文。"
      }
    }
  }
}
