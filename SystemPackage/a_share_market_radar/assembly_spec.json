{
  "schema_version": "0.1",
  "agent": {
    "id": "a_share_market_radar",
    "name": "A 股盘面雷达",
    "description": "聚合 A 股市场宽度、成交额、领涨个股和行业表现，生成可保存并经用户确认发送的市场简报。",
    "version": "0.1.0"
  },
  "runtime": {
    "pattern_id": "react_agent",
    "compiled_pattern_id": null,
    "user_config": {},
    "agent_config": {
      "agent_id": "a_share_market_radar"
    }
  },
  "graph_overrides": {
    "node_wrappers": []
  },
  "bindings": {
    "services": [],
    "node_bindings": [
      {
        "binding_id": "answer_prompt",
        "binding_type": "prompt",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "prompt_id": "answer_prompt",
          "template": "你是 A 股盘面雷达，只处理中国 A 股市场观察。处理盘面概览、盘前观察、盘中快报、收盘复盘或邮件简报等实质任务时，先用 skill(action='load', name='a-share-market-briefing', current_system='a_share_market_radar', reason='执行 A 股市场简报流程') 加载完整流程。涉及当前行情、涨跌家数、成交额、领涨个股或行业表现时，必须先调用 get_a_share_market_snapshot，明确数据时间、数据源和任何 partial/error 状态，不得凭模型记忆编造实时数据。你可以根据工具事实生成盘前、盘中或盘后简报，并在用户要求时用 write 保存到 Workspace。只有用户明确要求发送邮件时才调用 send_market_brief_email；发送前必须先展示或确认收件人、主题和正文，SMTP 未配置时如实说明需要在包详情的 Resource 配置中填写。scheduler 可用于安排后续市场观察任务，但无人值守任务仍须遵循用户明确指定的发送目标。知识库仅在用户挂载并要求依据内部投研规范或资料回答时查询。输出必须区分数据事实、分析判断和风险提示，不承诺收益、不执行交易，也不把市场观察表述为确定性投资建议。",
          "variables": []
        }
      },
      {
        "binding_id": "answer_tool_access",
        "binding_type": "tool_access",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "allowed_tool_ids": [
            "get_a_share_market_snapshot",
            "send_market_brief_email",
            "skill",
            "knowledge",
            "scheduler",
            "write"
          ],
          "approval_policy": "allow_all"
        }
      },
      {
        "binding_id": "answer_model_operation",
        "binding_type": "model_operation",
        "target": {
          "node_id": "answer",
          "impl": "cognitive.answer"
        },
        "payload": {
          "operation": "tool_bound_chat",
          "model_role": "main",
          "output_schema": {
            "type": "object",
            "additionalProperties": true
          },
          "write_target": {
            "section": "context"
          },
          "max_attempts": 3,
          "prompt_id": "answer_prompt"
        }
      }
    ],
    "hooks": []
  },
  "tools": [
    {
      "id": "get_a_share_market_snapshot",
      "description": "获取当前 A 股全市场行情快照，计算涨跌家数、成交额、领涨个股和可选行业表现。涉及当前盘面事实时必须先调用；返回数据时间、来源和部分失败信息。",
      "schema_error_guidance": "top_n 必须是 1 到 20 的整数；include_industries 必须是布尔值。",
      "entrypoint": "python:tools/get_a_share_market_snapshot/tool.py:run",
      "input_schema": {
        "type": "object",
        "properties": {
          "top_n": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10},
          "include_industries": {"type": "boolean", "default": true}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["success", "partial", "error"]},
          "observed_at": {"type": "string"},
          "source": {"type": "string"},
          "market": {"type": "object"},
          "top_gainers": {"type": "array", "items": {"type": "object"}},
          "top_turnover": {"type": "array", "items": {"type": "object"}},
          "industries": {"type": "array", "items": {"type": "object"}},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string"}
        },
        "required": ["status", "observed_at", "source", "warnings"],
        "additionalProperties": false
      },
      "resources": {},
      "risk_level": "low",
      "risk_evaluator": {"hard": null, "llm": null, "llm_mode": "disabled"},
      "concurrent": false,
      "permission_scope": "package",
      "permission_tags": ["read_only"],
      "output_compression": {"action_argument": "action", "actions": {}},
      "output_projection": "compress"
    },
    {
      "id": "send_market_brief_email",
      "description": "通过用户配置的 SMTP 账户发送已经确认的 A 股市场简报。调用前必须确认收件人、主题和正文；工具按低风险直接执行，不触发审批流程。",
      "schema_error_guidance": "recipients 必须包含 1 到 10 个有效邮箱地址；subject 和 body 不能为空。",
      "entrypoint": "python:tools/send_market_brief_email/tool.py:run",
      "input_schema": {
        "type": "object",
        "properties": {
          "recipients": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 3}},
          "subject": {"type": "string", "minLength": 1, "maxLength": 200},
          "body": {"type": "string", "minLength": 1, "maxLength": 100000}
        },
        "required": ["recipients", "subject", "body"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["sent"]},
          "sent_at": {"type": "string"},
          "recipients": {"type": "array", "items": {"type": "string"}},
          "message_id": {"type": "string"}
        },
        "required": ["status", "sent_at", "recipients", "message_id"],
        "additionalProperties": false
      },
      "resources": {"smtp": "smtp_account"},
      "risk_level": "low",
      "risk_evaluator": {"hard": null, "llm": null, "llm_mode": "disabled"},
      "concurrent": false,
      "permission_scope": "package",
      "permission_tags": ["external_communication"],
      "output_compression": {"action_argument": "action", "actions": {}},
      "output_projection": "passthrough"
    }
  ],
  "output": {
    "citations_required": false,
    "format": "markdown"
  },
  "harness": [],
  "metadata": {
    "provenance": {
      "source": "system_package",
      "package_id": "a_share_market_radar"
    },
    "scope": "a_share_only"
  }
}
