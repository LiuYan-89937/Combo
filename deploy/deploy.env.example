# FastAgentFactory 本机控制端 -> RadeonCloud 推理节点部署配置。
# 首次使用只需填写 SSH_HOST、SSH_PORT、SSH_USER；SSH_KEY 可留空交给 ssh-agent 选择。

SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_KEY=

# 远端工作目录。若实例提供持久卷，请把模型、状态和 llama.cpp 路径改到持久卷挂载点。
REMOTE_PROJECT_ROOT=/root/FastAgentFactory
REMOTE_STATE_ROOT=/root/.fastagentfactory
REMOTE_MODEL_ROOT=/root/models
REMOTE_LLAMA_CPP_DIR=/root/llama.cpp

# 本机 llama.cpp 工作副本。后续 AMD 算子改造直接在这里创建分支。
LOCAL_LLAMA_CPP_DIR=vendor/llama.cpp
LLAMA_CPP_REPOSITORY=https://gitcode.com/gh_mirrors/ll/llama.cpp.git
LLAMA_CPP_REVISION=f955e394bf94e01e5e36186d13c985727e5ef5b5

# 国内下载源。Chat GGUF 走 Hugging Face 国内镜像，Embedding 走 ModelScope。
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
HF_ENDPOINT=https://hf-mirror.com
CHAT_MODEL_REPOSITORY=SC117/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-GGUF
CHAT_MODEL_REVISION=dc1e5523d5924b641adb0fabb4ecde27fc261b0b
CHAT_MODEL_FILENAME=Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-I-Quality.gguf
CHAT_MODEL_SHA256=31a6a415d4de270cdd2128103a671202f4b92b6eb30c5f87934f3b06fc2a55cc
CHAT_MMPROJ_FILENAME=mmproj-Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-F16.gguf
CHAT_MMPROJ_SHA256=c8e702344a81f8c226a914aa980ed6e1f604bce9374f1fed8e65c896908af414
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=master

# 推理 Profile。上下文、并发和 KV 类型会进入远端 llama-server 启动参数。
CHAT_PROFILE_ID=qwen3_6_35b_a3b_apex_i_quality_chat
CHAT_SERVED_MODEL_NAME=Qwen3.6-35B-A3B-APEX-I-Quality
CHAT_CONTEXT_SIZE=256000
CHAT_MAX_OUTPUT_TOKENS=32768
CHAT_COMPRESSION_THRESHOLD=220000
CHAT_GPU_LAYERS=99
CHAT_PARALLEL_SLOTS=1
CHAT_CACHE_TYPE_K=q8_0
CHAT_CACHE_TYPE_V=q8_0
CHAT_FLASH_ATTENTION=1
CHAT_REASONING_SUPPORTED=1

EMBEDDING_PROFILE_ID=bge_m3_embedding
EMBEDDING_SERVED_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TRUST_REMOTE_CODE=0

# 三个服务只监听远端回环地址，由 SSH 隧道转发到本机。
REMOTE_CHAT_PORT=8003
REMOTE_EMBEDDING_PORT=8002
REMOTE_TELEMETRY_PORT=8004
LOCAL_CHAT_PORT=18003
LOCAL_EMBEDDING_PORT=18002
LOCAL_TELEMETRY_PORT=18004

# 仅在远端缺少 cmake/ninja/curl 等普通构建工具时安装；不会升级 ROCm、PyTorch 或驱动。
REMOTE_INSTALL_BUILD_TOOLS=1
