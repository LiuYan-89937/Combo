{
  "$defs": {
    "AgentSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "BindingSet": {
      "additionalProperties": false,
      "properties": {
        "hooks": {
          "items": {
            "$ref": "#/$defs/HookBinding"
          },
          "title": "Hooks",
          "type": "array"
        },
        "node_bindings": {
          "items": {
            "$ref": "#/$defs/NodeBinding"
          },
          "title": "Node Bindings",
          "type": "array"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceBindingSpec"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "title": "BindingSet",
      "type": "object"
    },
    "CustomBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "extension_id": {
          "title": "Extension Id",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "default": "v0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "extension_id",
        "purpose"
      ],
      "title": "CustomBindingPayload",
      "type": "object"
    },
    "GraphOverrides": {
      "additionalProperties": false,
      "properties": {
        "node_wrappers": {
          "items": {
            "$ref": "#/$defs/NodeWrapperOverride"
          },
          "title": "Node Wrappers",
          "type": "array"
        }
      },
      "title": "GraphOverrides",
      "type": "object"
    },
    "HarnessScenario": {
      "additionalProperties": false,
      "properties": {
        "agent_config": {
          "additionalProperties": true,
          "title": "Agent Config",
          "type": "object"
        },
        "assertions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Assertions",
          "type": "array"
        },
        "input_text": {
          "title": "Input Text",
          "type": "string"
        },
        "resume_after_interrupt": {
          "default": false,
          "title": "Resume After Interrupt",
          "type": "boolean"
        },
        "resume_payload": {
          "additionalProperties": true,
          "title": "Resume Payload",
          "type": "object"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "session_config": {
          "additionalProperties": true,
          "title": "Session Config",
          "type": "object"
        },
        "user_config": {
          "additionalProperties": true,
          "title": "User Config",
          "type": "object"
        }
      },
      "required": [
        "scenario_id",
        "input_text"
      ],
      "title": "HarnessScenario",
      "type": "object"
    },
    "HookBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "hook_point": {
          "enum": [
            "pre_cognitive",
            "post_cognitive",
            "pre_operational",
            "post_operational",
            "pre_governance",
            "post_governance",
            "pre_terminal",
            "post_terminal",
            "on_interrupt",
            "on_resume"
          ],
          "title": "Hook Point",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "binding_id",
        "hook_point"
      ],
      "title": "HookBinding",
      "type": "object"
    },
    "ModelOperationBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "model_role": {
          "default": "main",
          "enum": [
            "main",
            "task"
          ],
          "title": "Model Role",
          "type": "string"
        },
        "operation": {
          "enum": [
            "chat",
            "tool_bound_chat",
            "structured_json"
          ],
          "title": "Operation",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "structured_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Method"
        },
        "write_target": {
          "$ref": "#/$defs/ModelOperationWriteTarget"
        }
      },
      "required": [
        "operation",
        "write_target"
      ],
      "title": "ModelOperationBindingPayload",
      "type": "object"
    },
    "ModelOperationWriteTarget": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "title": "Path",
          "type": "array"
        },
        "section": {
          "enum": [
            "package_state",
            "context"
          ],
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "section"
      ],
      "title": "ModelOperationWriteTarget",
      "type": "object"
    },
    "NodeBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "binding_type": {
          "enum": [
            "prompt",
            "tool_access",
            "model_operation",
            "policy_profile",
            "strategy_profile",
            "output_formatter",
            "custom"
          ],
          "title": "Binding Type",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptBindingPayload"
            },
            {
              "$ref": "#/$defs/ToolAccessBindingPayload"
            },
            {
              "$ref": "#/$defs/ModelOperationBindingPayload"
            },
            {
              "$ref": "#/$defs/PolicyProfileBindingPayload"
            },
            {
              "$ref": "#/$defs/StrategyProfileBindingPayload"
            },
            {
              "$ref": "#/$defs/OutputFormatterBindingPayload"
            },
            {
              "$ref": "#/$defs/CustomBindingPayload"
            }
          ],
          "title": "Payload"
        },
        "target": {
          "$ref": "#/$defs/NodeBindingTarget"
        }
      },
      "required": [
        "binding_id",
        "binding_type",
        "target",
        "payload"
      ],
      "title": "NodeBinding",
      "type": "object"
    },
    "NodeBindingTarget": {
      "additionalProperties": false,
      "properties": {
        "impl": {
          "title": "Impl",
          "type": "string"
