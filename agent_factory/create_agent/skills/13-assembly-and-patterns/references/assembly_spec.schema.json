      },
      "required": [
        "node_id",
        "impl"
      ],
      "title": "NodeBindingTarget",
      "type": "object"
    },
    "NodeWrapperOverride": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
