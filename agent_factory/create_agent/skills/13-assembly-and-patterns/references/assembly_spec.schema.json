      "required": [
        "node_id"
      ],
      "title": "NodeWrapperOverride",
      "type": "object"
    },
    "OutputFormatterBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "formatter_id": {
          "title": "Formatter Id",
          "type": "string"
        },
        "mode": {
          "default": "identity",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "formatter_id"
      ],
      "title": "OutputFormatterBindingPayload",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "citations_required": {
          "default": false,
          "title": "Citations Required",
          "type": "boolean"
        },
        "format": {
          "default": "text",
          "enum": [
            "text",
            "json",
            "markdown"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "title": "OutputSpec",
      "type": "object"
    },
    "PatternNodeWrapperSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "phase": {
          "enum": [
            "before",
            "after",
            "on_error"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "id",
        "phase"
      ],
      "title": "PatternNodeWrapperSpec",
      "type": "object"
    },
    "PolicyProfileBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "rules": {
          "additionalProperties": true,
          "title": "Rules",
          "type": "object"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "PolicyProfileBindingPayload",
      "type": "object"
    },
    "PromptBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "template": {
          "title": "Template",
          "type": "string"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "prompt_id",
        "template"
      ],
