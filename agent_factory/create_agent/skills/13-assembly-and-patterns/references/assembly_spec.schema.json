      "type": "object"
    },
    "RuntimeSpec": {
      "additionalProperties": false,
      "properties": {
        "agent_config": {
          "additionalProperties": true,
          "title": "Agent Config",
          "type": "object"
        },
        "compiled_pattern_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compiled Pattern Id"
        },
        "pattern_id": {
          "title": "Pattern Id",
          "type": "string"
        },
        "user_config": {
          "additionalProperties": true,
          "title": "User Config",
          "type": "object"
        }
      },
      "required": [
        "pattern_id"
      ],
      "title": "RuntimeSpec",
      "type": "object"
    },
    "ServiceBindingSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "kind": {
          "enum": [
            "model_service",
            "model_operation_service",
            "tool_registry",
            "memory_store",
            "memory_system",
            "knowledge_runtime",
            "context_engine",
            "policy_engine",
            "observability_manager",
            "trace_recorder",
            "trace_reader",
            "trace_projector",
            "trace_diagnostics",
            "checkpointer",
            "harness_bridge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "service_id": {
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "kind"
      ],
      "title": "ServiceBindingSpec",
      "type": "object"
    },
    "StrategyProfileBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "strategy_ids": {
          "items": {
            "type": "string"
          },
          "title": "Strategy Ids",
          "type": "array"
        }
      },
      "title": "StrategyProfileBindingPayload",
      "type": "object"
    },
    "ToolAccessBindingPayload": {
      "additionalProperties": false,
      "properties": {
        "allowed_tool_ids": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tool Ids",
          "type": "array"
        },
        "approval_policy": {
          "default": "standard",
          "title": "Approval Policy",
          "type": "string"
        }
      },
      "title": "ToolAccessBindingPayload",
      "type": "object"
    },
    "ToolRiskEvaluatorConfig": {
      "additionalProperties": false,
      "properties": {
        "hard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard"
        },
        "llm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm"
        },
        "llm_mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "on_uncertain",
            "always"
          ],
          "title": "Llm Mode",
          "type": "string"
        }
      },
      "title": "ToolRiskEvaluatorConfig",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": false,
      "properties": {
        "concurrent": {
          "default": true,
          "title": "Concurrent",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "entrypoint": {
          "title": "Entrypoint",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "resources": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Resources",
          "type": "object"
        },
        "risk_evaluator": {
          "$ref": "#/$defs/ToolRiskEvaluatorConfig"
        },
        "risk_level": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "entrypoint"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentSpec"
    },
    "bindings": {
      "$ref": "#/$defs/BindingSet"
    },
    "graph_overrides": {
      "$ref": "#/$defs/GraphOverrides"
    },
    "harness": {
      "items": {
        "$ref": "#/$defs/HarnessScenario"
      },
      "title": "Harness",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "output": {
      "$ref": "#/$defs/OutputSpec"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeSpec"
    },
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolSpec"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "agent",
    "runtime"
  ],
  "title": "AgentAssemblySpec",
  "type": "object"
}
