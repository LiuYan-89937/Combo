{
  "$defs": {
    "SchedulerFailurePolicy": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "pause",
          "default": "pause",
          "title": "Action",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_consecutive_failures": {
          "default": 3,
          "minimum": 1,
          "title": "Max Consecutive Failures",
          "type": "integer"
        }
      },
      "title": "SchedulerFailurePolicy",
      "type": "object"
    },
    "SchedulerFeedbackConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "const": "llm_summary",
          "default": "llm_summary",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "SchedulerFeedbackConfig",
      "type": "object"
    },
    "SchedulerSeedContractConfig": {
      "additionalProperties": false,
      "properties": {
        "seeds": {
          "items": {
            "$ref": "#/$defs/SchedulerSeedPlan"
          },
          "title": "Seeds",
          "type": "array"
        }
      },
      "title": "SchedulerSeedContractConfig",
      "type": "object"
    },
    "SchedulerSeedPlan": {
      "additionalProperties": false,
      "properties": {
        "concurrency_policy": {
          "default": "skip",
          "enum": [
            "skip",
            "queue",
            "replace"
          ],
          "title": "Concurrency Policy",
          "type": "string"
        },
        "enabled_on_apply": {
          "default": true,
          "title": "Enabled On Apply",
          "type": "boolean"
        },
        "failure_policy": {
          "$ref": "#/$defs/SchedulerFailurePolicy"
        },
        "feedback": {
          "$ref": "#/$defs/SchedulerFeedbackConfig"
        },
        "human_schedule": {
          "title": "Human Schedule",
          "type": "string"
        },
        "max_concurrent_runs": {
          "default": 1,
          "minimum": 1,
          "title": "Max Concurrent Runs",
          "type": "integer"
        },
        "schedule_expr": {
          "title": "Schedule Expr",
          "type": "string"
        },
        "schedule_type": {
          "enum": [
            "cron",
            "interval",
            "date"
          ],
          "title": "Schedule Type",
          "type": "string"
        },
        "seed_id": {
          "title": "Seed Id",
          "type": "string"
        },
        "source_slot_id": {
          "title": "Source Slot Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/SchedulerTarget"
        },
        "task_content": {
          "title": "Task Content",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 900,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "timezone": {
          "default": "Asia/Shanghai",
          "title": "Timezone",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unattended_policy": {
          "default": "deny_if_approval_required",
          "enum": [
            "deny_if_approval_required",
            "pause_and_wait_for_user",
            "allow_preapproved_only"
          ],
          "title": "Unattended Policy",
          "type": "string"
        }
      },
      "required": [
        "seed_id",
        "title",
        "human_schedule",
        "schedule_type",
        "schedule_expr",
        "target",
        "task_content",
        "source_slot_id"
      ],
      "title": "SchedulerSeedPlan",
      "type": "object"
    },
    "SchedulerTarget": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "target_type": {
          "enum": [
            "graph_run",
            "script_run",
            "tool_call"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "target_type"
      ],
      "title": "SchedulerTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/SchedulerSeedContractConfig"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "type": {
      "const": "scheduler_seed",
      "default": "scheduler_seed",
      "title": "Type",
      "type": "string"
    },
    "version": {
      "const": "scheduler_seed_contract.v0",
      "default": "scheduler_seed_contract.v0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "SchedulerSeedContract",
  "type": "object"
}
