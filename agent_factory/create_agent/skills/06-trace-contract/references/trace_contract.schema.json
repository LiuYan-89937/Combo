        "max_inline_payload_chars": {
          "default": 12000,
          "minimum": 1000,
          "title": "Max Inline Payload Chars",
          "type": "integer"
        },
        "root": {
          "default": ".agent_runtime/trace",
          "title": "Root",
          "type": "string"
        }
      },
      "title": "TraceContractConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/TraceContractConfig"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "type": {
      "const": "trace",
      "default": "trace",
      "title": "Type",
      "type": "string"
    },
    "version": {
      "const": "trace_contract.v0",
      "default": "trace_contract.v0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "TraceContract",
  "type": "object"
