          },
          "title": "OutputSpec",
          "type": "object"
        },
        "PatternNodeWrapperSpec": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "phase": {
              "enum": [
                "before",
                "after",
                "on_error"
              ],
              "title": "Phase",
              "type": "string"
            },
            "order": {
              "default": 0,
              "title": "Order",
              "type": "integer"
