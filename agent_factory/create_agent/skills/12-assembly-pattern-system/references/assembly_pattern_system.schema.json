            "config": {
              "additionalProperties": true,
              "title": "Config",
              "type": "object"
            }
          },
          "required": [
            "id",
            "phase"
          ],
          "title": "PatternNodeWrapperSpec",
          "type": "object"
        },
        "PolicyProfileBindingPayload": {
          "additionalProperties": false,
          "properties": {
            "profile_id": {
              "title": "Profile Id",
              "type": "string"
            },
            "rules": {
              "additionalProperties": true,
              "title": "Rules",
              "type": "object"
            }
          },
          "required": [
            "profile_id"
          ],
          "title": "PolicyProfileBindingPayload",
          "type": "object"
        },
        "PromptBindingPayload": {
          "additionalProperties": false,
          "properties": {
            "prompt_id": {
              "title": "Prompt Id",
