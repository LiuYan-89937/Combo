            },
            "template": {
              "title": "Template",
              "type": "string"
            },
            "variables": {
              "items": {
                "type": "string"
              },
              "title": "Variables",
              "type": "array"
            }
          },
          "required": [
            "prompt_id",
            "template"
          ],
          "title": "PromptBindingPayload",
          "type": "object"
        },
        "RuntimeSpec": {
          "additionalProperties": false,
          "properties": {
            "pattern_id": {
              "title": "Pattern Id",
              "type": "string"
            },
            "compiled_pattern_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Compiled Pattern Id"
            },
            "user_config": {
              "additionalProperties": true,
              "title": "User Config",
              "type": "object"
            },
            "agent_config": {
              "additionalProperties": true,
              "title": "Agent Config",
              "type": "object"
            }
          },
          "required": [
            "pattern_id"
          ],
          "title": "RuntimeSpec",
          "type": "object"
        },
        "ServiceBindingSpec": {
          "additionalProperties": false,
