          "title": "HarnessScenario",
          "type": "object"
        },
        "HookBinding": {
          "additionalProperties": false,
          "properties": {
            "binding_id": {
              "title": "Binding Id",
              "type": "string"
            },
            "hook_point": {
              "enum": [
                "pre_cognitive",
                "post_cognitive",
                "pre_operational",
                "post_operational",
                "pre_governance",
                "post_governance",
                "pre_terminal",
                "post_terminal",
                "on_interrupt",
                "on_resume"
              ],
              "title": "Hook Point",
              "type": "string"
            },
            "enabled": {
              "default": true,
              "title": "Enabled",
              "type": "boolean"
            },
            "order": {
              "default": 0,
              "title": "Order",
              "type": "integer"
            },
            "payload": {
              "additionalProperties": true,
              "title": "Payload",
              "type": "object"
            }
          },
          "required": [
            "binding_id",
            "hook_point"
          ],
          "title": "HookBinding",
          "type": "object"
        },
        "ModelOperationBindingPayload": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "chat",
                "tool_bound_chat",
                "structured_json"
