              "title": "Operation",
              "type": "string"
            },
            "model_role": {
              "default": "main",
              "enum": [
                "main",
                "task"
              ],
              "title": "Model Role",
              "type": "string"
            },
            "output_schema": {
              "additionalProperties": true,
              "title": "Output Schema",
              "type": "object"
            },
            "write_target": {
              "$ref": "#/$defs/ModelOperationWriteTarget"
            },
            "max_attempts": {
              "default": 5,
              "minimum": 1,
              "title": "Max Attempts",
              "type": "integer"
            },
            "structured_method": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Structured Method"
            },
            "prompt_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Prompt Id"
            }
          },
          "required": [
            "operation",
            "write_target"
          ],
          "title": "ModelOperationBindingPayload",
          "type": "object"
        },
        "ModelOperationWriteTarget": {
          "additionalProperties": false,
          "properties": {
            "section": {
              "enum": [
                "package_state",
                "context"
              ],
              "title": "Section",
              "type": "string"
            },
            "namespace": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Namespace"
            },
            "path": {
              "items": {
                "type": "string"
              },
              "title": "Path",
              "type": "array"
            }
          },
          "required": [
            "section"
          ],
          "title": "ModelOperationWriteTarget",
          "type": "object"
        },
        "NodeBinding": {
          "additionalProperties": false,
          "properties": {
            "binding_id": {
              "title": "Binding Id",
              "type": "string"
            },
            "binding_type": {
              "enum": [
                "prompt",
                "tool_access",
                "model_operation",
                "policy_profile",
                "strategy_profile",
                "output_formatter",
                "custom"
              ],
              "title": "Binding Type",
              "type": "string"
