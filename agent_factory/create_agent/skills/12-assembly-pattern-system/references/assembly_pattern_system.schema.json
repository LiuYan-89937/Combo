            "llm_mode": {
              "default": "disabled",
              "enum": [
                "disabled",
                "on_uncertain",
                "always"
              ],
              "title": "Llm Mode",
              "type": "string"
            }
          },
          "title": "ToolRiskEvaluatorConfig",
          "type": "object"
        },
        "ToolSpec": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
