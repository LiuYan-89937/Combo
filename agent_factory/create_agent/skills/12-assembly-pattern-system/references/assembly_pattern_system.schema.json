{
  "type": "object",
  "title": "Assembly spec and custom pattern",
  "description": "System resource map. Each property is the schema for the named package file.",
  "additionalProperties": false,
  "properties": {
    "assembly_spec.json": {
      "$defs": {
        "AgentIdentitySpec": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Description"
            },
            "version": {
              "default": "0.1.0",
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "title": "AgentIdentitySpec",
          "type": "object"
        },
        "BindingSet": {
          "additionalProperties": false,
          "properties": {
            "services": {
              "items": {
                "$ref": "#/$defs/ServiceBindingSpec"
              },
              "title": "Services",
              "type": "array"
            },
            "node_bindings": {
              "items": {
                "$ref": "#/$defs/NodeBinding"
              },
              "title": "Node Bindings",
              "type": "array"
            },
            "hooks": {
              "items": {
                "$ref": "#/$defs/HookBinding"
              },
              "title": "Hooks",
              "type": "array"
            }
          },
          "title": "BindingSet",
          "type": "object"
        },
        "CustomBindingPayload": {
          "additionalProperties": false,
          "properties": {
            "extension_id": {
              "title": "Extension Id",
              "type": "string"
            },
            "schema_version": {
              "default": "v0",
              "title": "Schema Version",
              "type": "string"
            },
            "purpose": {
              "title": "Purpose",
              "type": "string"
            },
            "config": {
              "additionalProperties": true,
              "title": "Config",
              "type": "object"
            }
          },
          "required": [
            "extension_id",
            "purpose"
          ],
          "title": "CustomBindingPayload",
          "type": "object"
        },
        "GraphOverrides": {
