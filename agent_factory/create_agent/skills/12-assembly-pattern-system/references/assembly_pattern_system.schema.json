              "type": "array"
            }
          },
          "title": "GraphOverrides",
          "type": "object"
        },
        "HarnessScenario": {
          "additionalProperties": false,
          "properties": {
            "scenario_id": {
              "title": "Scenario Id",
              "type": "string"
            },
            "input_text": {
              "title": "Input Text",
              "type": "string"
            },
            "user_config": {
              "additionalProperties": true,
              "title": "User Config",
              "type": "object"
            },
            "agent_config": {
              "additionalProperties": true,
              "title": "Agent Config",
              "type": "object"
            },
            "session_config": {
              "additionalProperties": true,
              "title": "Session Config",
              "type": "object"
            },
            "resume_payload": {
              "additionalProperties": true,
