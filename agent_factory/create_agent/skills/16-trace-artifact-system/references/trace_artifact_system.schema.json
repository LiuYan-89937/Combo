{
  "type": "object",
  "title": "Trace and artifact contracts",
  "description": "System resource map. Each property is the schema for the named package file.",
  "additionalProperties": false,
  "properties": {
    "contracts/trace.json": {
      "$defs": {
        "TraceContractConfig": {
          "additionalProperties": false,
          "properties": {
            "root": {
              "default": ".agent_runtime/trace",
              "title": "Root",
              "type": "string"
            },
            "max_inline_payload_chars": {
              "default": 12000,
              "minimum": 1000,
              "title": "Max Inline Payload Chars",
              "type": "integer"
            }
          },
          "title": "TraceContractConfig",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "trace",
          "default": "trace",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "trace_contract.v0",
          "default": "trace_contract.v0",
          "title": "Version",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "config": {
          "$ref": "#/$defs/TraceContractConfig"
        }
      },
      "title": "contracts/trace.json",
      "type": "object"
    },
    "contracts/artifact.json": {
      "$defs": {
        "ArtifactContractConfig": {
          "additionalProperties": false,
          "properties": {
            "root": {
              "default": ".agent_runtime/artifacts",
              "title": "Root",
              "type": "string"
            },
            "index_path": {
              "default": ".agent_runtime/artifacts/index.jsonl",
              "title": "Index Path",
              "type": "string"
            },
            "allowed_kinds": {
              "items": {
                "type": "string"
              },
              "title": "Allowed Kinds",
              "type": "array"
            }
          },
          "title": "ArtifactContractConfig",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "artifact_contract.v0",
          "default": "artifact_contract.v0",
          "title": "Version",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "config": {
          "$ref": "#/$defs/ArtifactContractConfig"
        }
      },
      "title": "contracts/artifact.json",
      "type": "object"
    }
  },
  "required": [
    "contracts/trace.json",
    "contracts/artifact.json"
  ]
}
