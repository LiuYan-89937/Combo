          "type": "string"
        },
        "recommended_resources": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Resources",
          "type": "array"
        },
        "recommended_skill": {
          "default": "",
          "title": "Recommended Skill",
          "type": "string"
        },
        "target_files": {
          "items": {
            "type": "string"
          },
          "title": "Target Files",
          "type": "array"
        }
      },
      "title": "PackageValidationNextAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cached": {
      "default": false,
