{
  "type": "object",
  "title": "State contract and state files",
  "description": "System resource map. Each property is the schema for the named package file.",
  "additionalProperties": false,
  "properties": {
    "contracts/state.json": {
      "$defs": {
        "StateContractConfig": {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "default": "package",
              "title": "Namespace",
              "type": "string"
            },
            "schema_path": {
              "default": "state/package.schema.json",
              "title": "Schema Path",
              "type": "string"
            },
            "initial_state_path": {
              "default": "state/package.initial.json",
              "title": "Initial State Path",
              "type": "string"
            },
            "writable_node_ids": {
              "items": {
                "type": "string"
              },
              "title": "Writable Node Ids",
              "type": "array"
            }
          },
          "title": "StateContractConfig",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "state",
          "default": "state",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "state_contract.v0",
          "default": "state_contract.v0",
          "title": "Version",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "config": {
          "$ref": "#/$defs/StateContractConfig"
        }
      },
      "title": "contracts/state.json",
      "type": "object"
    },
    "state/package.schema.json": {
      "type": "object",
      "title": "state/package.schema.json",
      "additionalProperties": true
    },
    "state/package.initial.json": {
      "type": "object",
      "title": "state/package.initial.json",
      "additionalProperties": true
    }
  },
  "required": [
    "contracts/state.json",
    "state/package.schema.json",
    "state/package.initial.json"
  ]
}
