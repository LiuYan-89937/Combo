{
  "config": {
    "memory_system": {
      "background": {
        "concurrency": 1,
        "journal_root": ".agent_runtime/memory/jobs",
        "max_pending_jobs": 32,
        "queue_full_policy": "reject_new_when_full",
        "write_interval_turns": 3
      },
      "enabled": true,
      "injection_enabled": true,
      "ranking": {
        "max_items_total": 8,
        "max_tokens_total": 1200,
        "min_score": 0.55,
        "per_kind_limits": {
          "artifact": 1,
          "constraint": 3,
          "decision": 2,
          "fact": 2,
          "preference": 3
        }
      },
      "semantic_index": {
        "enabled": false,
        "fields": [
          "content",
          "metadata.evidence_summary",
          "metadata.keywords",
          "metadata.entities",
          "metadata.embedding_text"
        ]
      },
      "store": {
        "backend": "sqlite",
        "path": ".agent_runtime/memory/agent.sqlite",
        "provider_options": {},
        "setup": true
      },
      "version": "memory_system.v0",
      "write_enabled": true
    }
  },
  "enabled": true,
  "type": "memory",
  "version": "memory_contract.v0"
}
