{
  "$defs": {
    "MemoryBackgroundConfig": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "journal_root": {
          "default": ".agent_runtime/memory/jobs",
          "title": "Journal Root",
          "type": "string"
        },
        "max_pending_jobs": {
          "default": 32,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Pending Jobs",
          "type": "integer"
        },
        "queue_full_policy": {
          "const": "reject_new_when_full",
          "default": "reject_new_when_full",
          "title": "Queue Full Policy",
          "type": "string"
        },
        "write_interval_turns": {
          "default": 3,
          "maximum": 1000,
          "minimum": 1,
          "title": "Write Interval Turns",
          "type": "integer"
        }
      },
      "title": "MemoryBackgroundConfig",
      "type": "object"
    },
    "MemoryContractConfig": {
      "additionalProperties": false,
      "properties": {
        "memory_system": {
          "$ref": "#/$defs/MemorySystemConfig"
        }
      },
      "title": "MemoryContractConfig",
      "type": "object"
    },
    "MemoryRankingConfig": {
      "additionalProperties": false,
      "properties": {
        "max_items_total": {
          "default": 8,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Items Total",
          "type": "integer"
        },
        "max_tokens_total": {
          "default": 1200,
          "maximum": 8000,
          "minimum": 100,
          "title": "Max Tokens Total",
          "type": "integer"
        },
        "min_score": {
          "default": 0.55,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Score",
          "type": "number"
        },
        "per_kind_limits": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Per Kind Limits",
          "type": "object"
        }
      },
      "title": "MemoryRankingConfig",
      "type": "object"
    },
    "MemorySemanticIndexConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "title": "MemorySemanticIndexConfig",
      "type": "object"
    },
    "MemoryStoreRuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "sqlite",
          "enum": [
            "sqlite",
            "memory",
            "postgres",
            "redis",
            "mongodb"
          ],
          "title": "Backend",
          "type": "string"
        },
        "collection_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Name"
        },
        "connection_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Uri"
        },
        "database_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database Name"
        },
        "path": {
          "default": ".agent_runtime/memory/agent.sqlite",
          "title": "Path",
          "type": "string"
        },
        "provider_options": {
          "additionalProperties": true,
          "title": "Provider Options",
          "type": "object"
        },
        "setup": {
          "default": true,
          "title": "Setup",
          "type": "boolean"
        }
      },
      "title": "MemoryStoreRuntimeConfig",
      "type": "object"
    },
    "MemorySystemConfig": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/MemoryBackgroundConfig"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "injection_enabled": {
          "default": true,
          "title": "Injection Enabled",
          "type": "boolean"
        },
        "ranking": {
          "$ref": "#/$defs/MemoryRankingConfig"
        },
        "semantic_index": {
          "$ref": "#/$defs/MemorySemanticIndexConfig"
        },
        "store": {
          "$ref": "#/$defs/MemoryStoreRuntimeConfig"
        },
        "version": {
          "const": "memory_system.v0",
          "default": "memory_system.v0",
          "title": "Version",
          "type": "string"
        },
        "write_enabled": {
          "default": true,
          "title": "Write Enabled",
          "type": "boolean"
        }
      },
      "title": "MemorySystemConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/MemoryContractConfig"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "type": {
      "const": "memory",
      "default": "memory",
      "title": "Type",
      "type": "string"
    },
    "version": {
      "const": "memory_contract.v0",
      "default": "memory_contract.v0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "MemoryContract",
  "type": "object"
}
