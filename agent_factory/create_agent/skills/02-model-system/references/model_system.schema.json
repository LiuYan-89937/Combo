{
  "type": "object",
  "title": "Model, dependency, and sandbox contracts",
  "description": "System resource map. Each property is the schema for the named package file.",
  "additionalProperties": false,
  "properties": {
    "contracts/model.json": {
      "type": "object",
      "title": "contracts/model.json",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "model",
          "default": "model",
          "type": "string"
        },
        "version": {
          "const": "model_contract.v1",
          "default": "model_contract.v1",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "main": {
                  "$ref": "#/$defs/ModelProfileBinding"
                },
                "task": {
                  "$ref": "#/$defs/ModelProfileBinding"
                },
                "compression": {
                  "$ref": "#/$defs/ModelProfileBinding"
                }
              },
              "required": [
                "main"
              ]
            },
            "tool_bindings": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ModelToolBinding"
              },
              "default": {}
            }
          },
          "required": [
            "bindings"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "enabled",
        "config"
      ]
    },
    "contracts/dependencies.json": {
      "$defs": {
        "DependenciesContractConfig": {
          "additionalProperties": false,
          "properties": {
            "python_requirements": {
              "items": {
                "type": "string"
              },
              "title": "Python Requirements",
              "type": "array"
            },
            "system_packages": {
              "items": {
                "type": "string"
              },
              "title": "System Packages",
              "type": "array"
            },
            "system_binaries": {
              "items": {
                "type": "string"
              },
              "title": "System Binaries",
              "type": "array"
            },
            "install_mode": {
              "default": "sandbox_init",
              "enum": [
                "none",
                "sandbox_init"
              ],
              "title": "Install Mode",
              "type": "string"
            }
          },
          "title": "DependenciesContractConfig",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "dependencies",
          "default": "dependencies",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "dependencies_contract.v0",
          "default": "dependencies_contract.v0",
          "title": "Version",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "config": {
          "$ref": "#/properties/contracts~1dependencies.json/$defs/DependenciesContractConfig"
        }
      },
      "title": "contracts/dependencies.json",
      "type": "object"
    },
    "contracts/sandbox.json": {
      "$defs": {
        "SandboxRuntimeContractConfig": {
          "additionalProperties": false,
          "properties": {
            "sandbox_contract_path": {
              "default": "sandbox_contract.json",
              "title": "Sandbox Contract Path",
              "type": "string"
            }
          },
          "title": "SandboxRuntimeContractConfig",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sandbox",
          "default": "sandbox",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "sandbox_contract.v0",
          "default": "sandbox_contract.v0",
          "title": "Version",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "config": {
          "$ref": "#/properties/contracts~1sandbox.json/$defs/SandboxRuntimeContractConfig"
        }
      },
      "title": "contracts/sandbox.json",
      "type": "object"
    },
    "sandbox_contract.json": {
      "type": "object",
      "title": "sandbox_contract.json",
      "additionalProperties": true
    }
  },
  "required": [
    "contracts/model.json",
    "contracts/dependencies.json",
    "contracts/sandbox.json",
    "sandbox_contract.json"
  ],
  "$defs": {
    "ModelProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "selection_source": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto"
        },
        "reason": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "object",
          "additionalProperties": true
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "multimodal": {
              "type": "boolean"
            },
            "structured_output_method": {
              "type": "string",
              "enum": [
                "function_calling",
                "json_mode",
                "json_schema"
              ]
            },
            "reasoning": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "effort": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "budget_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "send_history": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "required": [
        "profile_id"
      ]
    },
    "ModelToolBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "enum": [
            "image_input",
            "image_output",
            "image_edit",
            "audio_input",
            "audio_output"
          ]
        },
        "selection_source": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto"
        },
        "reason": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "object",
          "additionalProperties": true
        },
        "description": {
          "type": "string"
        },
        "overrides": {
          "$ref": "#/$defs/ModelBindingOverrides"
        }
      },
      "required": [
        "profile_id",
        "capability"
      ]
    },
    "ModelBindingOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "multimodal": {
          "type": "boolean"
        },
        "structured_output_method": {
          "type": "string",
          "enum": [
            "function_calling",
            "json_mode",
            "json_schema"
          ]
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "effort": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "budget_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "send_history": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
