# FastAgentFactory local ROCm configuration.
# Runtime model calls are restricted to local/private endpoints; cloud model API credentials are unsupported.

# Deployment-level local model storage.
AGENTFACTORY_MODEL_ROOT=

# Optional local endpoint overrides. Defaults are 127.0.0.1:8003/v1 and 127.0.0.1:8002.
AGENTFACTORY_INFERENCE_RUNTIME_MODE=managed
AGENTFACTORY_LOCAL_INFERENCE_ENDPOINT=
AGENTFACTORY_LOCAL_IMAGE_ENDPOINT=
AGENTFACTORY_LOCAL_INFERENCE_ALLOWED_HOSTS=
AGENTFACTORY_LOCAL_INFERENCE_TIMEOUT_SECONDS=
AGENTFACTORY_LLAMA_SERVER_PATH=
AGENTFACTORY_INFERENCE_TELEMETRY_ENDPOINT=

# Optional upper bound for collaboration worker tasks across all collaboration sessions.
# Leave empty to follow the active llama-server/Profile parallel slot count automatically.
AGENTFACTORY_COLLABORATION_MAX_PARALLEL_WORKERS=

# Main Agent continuation events are retained individually for audit, then coalesced
# into one continuation run after this short window. Batch size bounds one prompt.
AGENTFACTORY_COLLABORATION_EVENT_COALESCE_WINDOW_SECONDS=0.75
AGENTFACTORY_COLLABORATION_EVENT_BATCH_LIMIT=64

# Optional SSH tunnel for an external inference host. The key may be left empty
# when OpenSSH can select the correct key from ~/.ssh or ssh-agent.
AGENTFACTORY_INFERENCE_SSH_HOST=
AGENTFACTORY_INFERENCE_SSH_PORT=
AGENTFACTORY_INFERENCE_SSH_USER=
AGENTFACTORY_INFERENCE_SSH_KEY=
AGENTFACTORY_INFERENCE_SSH_CHAT_LOCAL_PORT=18003
AGENTFACTORY_INFERENCE_SSH_CHAT_REMOTE_PORT=8003
AGENTFACTORY_INFERENCE_SSH_EMBEDDING_LOCAL_PORT=18002
AGENTFACTORY_INFERENCE_SSH_EMBEDDING_REMOTE_PORT=8002
AGENTFACTORY_INFERENCE_SSH_TELEMETRY_LOCAL_PORT=18004
AGENTFACTORY_INFERENCE_SSH_TELEMETRY_REMOTE_PORT=8004
AGENTFACTORY_INFERENCE_SSH_IMAGE_LOCAL_PORT=18005
AGENTFACTORY_INFERENCE_SSH_IMAGE_REMOTE_PORT=8005

# Local Transformers embedding service.
AGENTFACTORY_LOCAL_EMBEDDING_ENDPOINT=
AGENTFACTORY_LOCAL_EMBEDDING_ALLOWED_HOSTS=
AGENTFACTORY_LOCAL_EMBEDDING_TIMEOUT_SECONDS=

# Memory policy.
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=

# Required to encrypt AgentPackage runtime resource values.
AGENTFACTORY_RESOURCE_MASTER_KEY=

# Maximum time for start.sh to wait until the local web backend health check
# succeeds before starting Vite. Slow cold starts may initialize Docker state.
AGENTFACTORY_WEB_BACKEND_STARTUP_TIMEOUT_SECONDS=180

# Docker runtime isolation for AgentPackages.
# logical reuses one Docker container while keeping bridge processes, package paths, and runtime directories isolated.
# dedicated starts one Docker container for each runtime context.
AGENTFACTORY_CONTAINER_ISOLATION=logical

# Maximum time allowed for an AgentPackage container to initialize before the
# broken runtime handle is closed and the instance enters failed state.
AGENTFACTORY_AGENT_RUNTIME_INITIALIZE_TIMEOUT_SECONDS=120

# Maximum time allowed for the stdio bridge inside a runtime container to
# announce readiness before the unusable process is closed.
AGENTFACTORY_AGENT_RUNTIME_BRIDGE_STARTUP_TIMEOUT_SECONDS=30

# Behavior when a package cannot share the logical runtime because of its image, network, or declared mounts.
# Values: dedicated, error.
AGENTFACTORY_CONTAINER_INCOMPATIBLE_POLICY=dedicated

# Set setup to 0 for local Agent/MCP execution. Existing checkouts are reused
# without contacting GitHub unless the explicit update switch is enabled.
AGENTFACTORY_SKIP_WEB_SEARCH_MCP_SETUP=1
AGENTFACTORY_UPDATE_WEB_SEARCH_MCP=0

# Optional Tavily provider for the built-in web_search MCP. The local runtime
# inherits this secret; never place a real key in SystemPackage JSON.
TAVILY_API_KEY=
