# FastAgentFactory local model configuration.
# Copy this file to `.env`, then fill in your provider values.
# `.env` is ignored by git and must never be committed.

# Provider.
# Supported values:
# - openai_compatible_chat: OpenAI-compatible Chat Completions provider.
# - fake: local deterministic test adapter; useful for unit tests only.
AGENTFACTORY_LLM_PROVIDER=openai_compatible_chat

# OpenAI-compatible Chat Completions endpoint.
# Examples:
# - DeepSeek: https://api.deepseek.com
# - OpenAI-compatible proxy: https://your-provider.example/v1
AGENTFACTORY_OPENAI_BASE_URL=
AGENTFACTORY_OPENAI_API_KEY=
AGENTFACTORY_OPENAI_MODEL=

# Main model behavior.
# For long Factory production runs, use a generous timeout.
AGENTFACTORY_LLM_TIMEOUT_SECONDS=600
AGENTFACTORY_LLM_TEMPERATURE=0.2
AGENTFACTORY_LLM_MAX_OUTPUT_TOKENS=8192

# Optional provider-specific thinking switch.
# Supported values in this codebase: enabled, disabled.
AGENTFACTORY_LLM_THINKING=disabled

# Optional small-task model for chat, light task flows, and llmRisk tool argument evaluation.
# Configure this when using `/chat` or ToolSpec.risk_evaluator.llm.
AGENTFACTORY_TASK_MODEL=
AGENTFACTORY_TASK_TEMPERATURE=0.1
AGENTFACTORY_TASK_MAX_OUTPUT_TOKENS=2048
AGENTFACTORY_TASK_THINKING=disabled

# Dedicated model for synchronous context compression.
# For now this can copy the small-task model settings; later it can point to a specialized compression model.
AGENTFACTORY_COMPRESSION_BASE_URL=
AGENTFACTORY_COMPRESSION_API_KEY=
AGENTFACTORY_COMPRESSION_MODEL=
AGENTFACTORY_COMPRESSION_TEMPERATURE=0.1
AGENTFACTORY_COMPRESSION_MAX_OUTPUT_TOKENS=2048
AGENTFACTORY_COMPRESSION_TIMEOUT_SECONDS=600
AGENTFACTORY_COMPRESSION_THINKING=disabled
AGENTFACTORY_CONTEXT_WINDOW_TOKENS=1000000

# Factory session and LangGraph checkpoint persistence.
AGENTFACTORY_SESSION_ROOT=.agentfactory/sessions
AGENTFACTORY_CHECKPOINTER_BACKEND=sqlite
AGENTFACTORY_CHECKPOINT_PATH=.agentfactory/checkpoints/factory.sqlite
AGENTFACTORY_MEMORY_STORE_BACKEND=sqlite
AGENTFACTORY_MEMORY_STORE_PATH=.agentfactory/memory/factory.sqlite
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=3

# OpenAI-compatible embeddings for cross-session memory semantic retrieval.
# Fill these values in `.env`; keep API keys out of git.
AGENTFACTORY_MEMORY_SEMANTIC_INDEX_ENABLED=true
AGENTFACTORY_EMBEDDING_PROVIDER=openai_compatible
AGENTFACTORY_EMBEDDING_BASE_URL=
AGENTFACTORY_EMBEDDING_API_KEY=
AGENTFACTORY_EMBEDDING_MODEL=
AGENTFACTORY_EMBEDDING_DIMS=1536
AGENTFACTORY_EMBEDDING_TIMEOUT_SECONDS=60
AGENTFACTORY_MEMORY_INDEX_FIELDS=content,metadata.evidence_summary,metadata.keywords,metadata.entities,metadata.embedding_text

# Unified tool runtime.
AGENTFACTORY_TOOL_MAX_REVISIONS=5

# Unified scheduler runtime.
AGENTFACTORY_SCHEDULER_ENABLED=true
AGENTFACTORY_SCHEDULER_STORE_BACKEND=sqlite
AGENTFACTORY_SCHEDULER_STORE_PATH=.agentfactory/scheduler/factory.sqlite
AGENTFACTORY_SCHEDULER_TIMEZONE=Asia/Shanghai
AGENTFACTORY_SCHEDULER_DEFAULT_TIMEOUT_SECONDS=900
AGENTFACTORY_SCHEDULER_UNATTENDED_POLICY=deny_if_approval_required
AGENTFACTORY_SCHEDULER_FAILURE_AUTO_PAUSE_ENABLED=true
AGENTFACTORY_SCHEDULER_MAX_CONSECUTIVE_FAILURES=3

# Generated AgentPackage runtime containers.
AGENTFACTORY_AGENT_RUNTIME_IDLE_TIMEOUT_SECONDS=1800
AGENTFACTORY_AGENT_RUNTIME_REQUEST_TIMEOUT_SECONDS=900
AGENTFACTORY_AGENT_RUNTIME_HEARTBEAT_SECONDS=10

# Host MCP gateway for generated AgentPackage containers.
# Leave the port empty to let the runtime choose a free local port per MCP config.
AGENTFACTORY_HOST_MCP_GATEWAY_BIND_HOST=127.0.0.1
AGENTFACTORY_HOST_MCP_GATEWAY_PORT=

# Optional real-provider smoke test switch.
# Keep disabled by default. Set to 1 only when you intentionally want tests to call the provider.
AGENTFACTORY_RUN_PROVIDER_SMOKE=0
