# Optional development-time process configuration.
# Desktop users configure chat and image models in the model pool UI; model
# endpoints and credentials are not loaded from this file.

# Required when multi-Agent collaboration is enabled. Set this to the number of
# worker model requests that the configured API provider can safely serve in parallel.
AGENTFACTORY_COLLABORATION_MAX_PARALLEL_WORKERS=

# Main Agent continuation events are retained individually for audit, then coalesced
# into one continuation run after this short window. Batch size bounds one prompt.
AGENTFACTORY_COLLABORATION_EVENT_COALESCE_WINDOW_SECONDS=0.75
AGENTFACTORY_COLLABORATION_EVENT_BATCH_LIMIT=64

# Embedding model for memory, knowledge base, and RAG semantic retrieval.
AGENTFACTORY_EMBEDDING_PROVIDER=openai_compatible
AGENTFACTORY_EMBEDDING_BASE_URL=
AGENTFACTORY_EMBEDDING_API_KEY=
AGENTFACTORY_EMBEDDING_MODEL=
AGENTFACTORY_EMBEDDING_DIMS=

# Required to encrypt runtime AgentPackage resource values. Use a long random value and keep it stable.
AGENTFACTORY_RESOURCE_MASTER_KEY=

# Model runtime limits.
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=3

# Maximum time allowed for an AgentPackage runtime to initialize before the
# broken runtime handle is closed and the instance enters failed state.
AGENTFACTORY_AGENT_RUNTIME_INITIALIZE_TIMEOUT_SECONDS=120

# Maximum time allowed for the local stdio bridge to
# announce readiness before the unusable process is closed.
AGENTFACTORY_AGENT_RUNTIME_BRIDGE_STARTUP_TIMEOUT_SECONDS=30

# Advanced options are intentionally omitted from the basic env file.
# Built-in defaults cover sessions, checkpoints, scheduler, tool approval, attachments,
# MCP/SkillHUB gateways, and AgentPackage runtime timeouts.
