# FastAgentFactory local configuration.
# Copy this file to `.env`, then fill in the model values below.
# `.env` is ignored by git and must never be committed.

# Main model.
# Provider values: openai_compatible_chat, openai_chat, anthropic, deepseek, qwen, zhipu, kimi, minimax, mimo, hunyuan.
AGENTFACTORY_MODEL_PROVIDER=openai_compatible_chat
AGENTFACTORY_MODEL_BASE_URL=
AGENTFACTORY_MODEL_API_KEY=
AGENTFACTORY_MAIN_MODEL=

# Task model. It can use a different provider/base URL/key from the main model.
# Leave provider/base URL/key empty to inherit the main model endpoint.
AGENTFACTORY_TASK_MODEL_PROVIDER=
AGENTFACTORY_TASK_MODEL_BASE_URL=
AGENTFACTORY_TASK_MODEL_API_KEY=
AGENTFACTORY_TASK_MODEL=

# Compression model. It can also use a different provider/base URL/key.
# Leave provider/base URL/key empty to inherit task model first, then main model.
AGENTFACTORY_COMPRESSION_MODEL_PROVIDER=
AGENTFACTORY_COMPRESSION_MODEL_BASE_URL=
AGENTFACTORY_COMPRESSION_MODEL_API_KEY=
AGENTFACTORY_COMPRESSION_MODEL=

# Optional default image model for the built-in factory_chat package.
# Leave all four values empty to disable image-generation tools without affecting chat.
# Provider values: openai_image, qwen, volcengine_seedream.
AGENTFACTORY_IMAGE_MODEL_PROVIDER=
AGENTFACTORY_IMAGE_MODEL_BASE_URL=
AGENTFACTORY_IMAGE_MODEL_API_KEY=
AGENTFACTORY_IMAGE_MODEL=
AGENTFACTORY_IMAGE_MODEL_TIMEOUT_SECONDS=

# Embedding model for memory, knowledge base, and RAG semantic retrieval.
AGENTFACTORY_EMBEDDING_PROVIDER=openai_compatible
AGENTFACTORY_EMBEDDING_BASE_URL=
AGENTFACTORY_EMBEDDING_API_KEY=
AGENTFACTORY_EMBEDDING_MODEL=
AGENTFACTORY_EMBEDDING_DIMS=

# Required to encrypt runtime AgentPackage resource values. Use a long random value and keep it stable.
AGENTFACTORY_RESOURCE_MASTER_KEY=

# Maximum time for start.sh to wait until the local web backend health check
# succeeds before starting Vite. Slow cold starts may initialize Docker state.
AGENTFACTORY_WEB_BACKEND_STARTUP_TIMEOUT_SECONDS=180

# Whether the main model supports native multimodal input.
AGENTFACTORY_MAIN_MODEL_MULTIMODAL=false

# Reasoning mode for the main model. Leave empty unless the selected provider/model supports reasoning.
# Values: enabled, disabled.
AGENTFACTORY_MODEL_REASONING=
AGENTFACTORY_MODEL_REASONING_EFFORT=

# Model runtime limits.
AGENTFACTORY_MODEL_COMPRESSION_TRIGGER_TOKENS=200000
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=3
AGENTFACTORY_MODEL_TEMPERATURE=0.2
AGENTFACTORY_MODEL_TIMEOUT_SECONDS=600
AGENTFACTORY_MODEL_MAX_OUTPUT_TOKENS=32768
AGENTFACTORY_TASK_MODEL_MAX_OUTPUT_TOKENS=16384
AGENTFACTORY_COMPRESSION_MODEL_MAX_OUTPUT_TOKENS=20000
AGENTFACTORY_MODEL_MAX_INPUT_TOKENS=1000000

# Docker runtime isolation for AgentPackages.
# logical reuses one Docker container while keeping separate bridge processes and runtime directories.
# dedicated starts one Docker container for each runtime context.
AGENTFACTORY_CONTAINER_ISOLATION=logical

# Maximum time allowed for an AgentPackage container to initialize before the
# broken runtime handle is closed and the instance enters failed state.
AGENTFACTORY_AGENT_RUNTIME_INITIALIZE_TIMEOUT_SECONDS=120

# Maximum time allowed for the stdio bridge inside a runtime container to
# announce readiness before the unusable process is closed.
AGENTFACTORY_AGENT_RUNTIME_BRIDGE_STARTUP_TIMEOUT_SECONDS=30

# Behavior when logical isolation cannot share an image, network, or package-declared mount.
# Values: dedicated, error.
AGENTFACTORY_CONTAINER_INCOMPATIBLE_POLICY=dedicated

# Advanced options are intentionally omitted from the basic env file.
# Built-in defaults cover sessions, checkpoints, scheduler, tool approval, attachments,
# MCP/SkillHUB gateways, and AgentPackage runtime timeouts.
