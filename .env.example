# FastAgentFactory local ROCm configuration.
# Runtime model calls are restricted to local/private endpoints; cloud model API credentials are unsupported.

# Deployment-level local model storage.
AGENTFACTORY_MODEL_ROOT=

# Optional local endpoint overrides. Defaults are 127.0.0.1:8003/v1 and 127.0.0.1:8002.
AGENTFACTORY_INFERENCE_RUNTIME_MODE=managed
AGENTFACTORY_LOCAL_INFERENCE_ENDPOINT=
AGENTFACTORY_LOCAL_INFERENCE_ALLOWED_HOSTS=
AGENTFACTORY_LOCAL_INFERENCE_TIMEOUT_SECONDS=
AGENTFACTORY_LLAMA_SERVER_PATH=
AGENTFACTORY_INFERENCE_TELEMETRY_ENDPOINT=

# Optional SSH tunnel for an external inference host. The key may be left empty
# when OpenSSH can select the correct key from ~/.ssh or ssh-agent.
AGENTFACTORY_INFERENCE_SSH_HOST=
AGENTFACTORY_INFERENCE_SSH_PORT=
AGENTFACTORY_INFERENCE_SSH_USER=
AGENTFACTORY_INFERENCE_SSH_KEY=
AGENTFACTORY_INFERENCE_SSH_CHAT_LOCAL_PORT=18003
AGENTFACTORY_INFERENCE_SSH_CHAT_REMOTE_PORT=8003
AGENTFACTORY_INFERENCE_SSH_TELEMETRY_LOCAL_PORT=18004
AGENTFACTORY_INFERENCE_SSH_TELEMETRY_REMOTE_PORT=8004

# Local Transformers embedding service.
AGENTFACTORY_LOCAL_EMBEDDING_ENDPOINT=
AGENTFACTORY_LOCAL_EMBEDDING_ALLOWED_HOSTS=
AGENTFACTORY_LOCAL_EMBEDDING_TIMEOUT_SECONDS=

# Memory policy.
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=

# Required to encrypt AgentPackage runtime resource values.
AGENTFACTORY_RESOURCE_MASTER_KEY=

# Competition mode disables automatic online MCP setup.
AGENTFACTORY_SKIP_WEB_SEARCH_MCP_SETUP=1
