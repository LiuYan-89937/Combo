# FastAgentFactory unified user configuration.
# Copy this file to .env. deploy.sh and start.sh read the same file; local
# inference endpoints are derived in memory from its target and port settings.

# Inference node: ssh for a remote GPU host, local for a ROCm GPU on this host.
DEPLOY_TARGET=ssh
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# Leave empty when ~/.ssh or ssh-agent already selects the correct key.
SSH_KEY=

# Optional deployment overrides belong here only when the built-in values in
# deploy/defaults.env do not fit the target host. Example:
# REMOTE_MODEL_ROOT=/data/models
# CHAT_PARALLEL_SLOTS=2

# deploy.sh generates AGENTFACTORY_RESOURCE_MASTER_KEY on first use for
# encrypted AgentPackage resource values.

# Optional Tavily provider for the built-in web_search MCP.
TAVILY_API_KEY=

# User-facing runtime preferences.
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=3
AGENTFACTORY_SKIP_WEB_SEARCH_MCP_SETUP=1
AGENTFACTORY_UPDATE_WEB_SEARCH_MCP=0
