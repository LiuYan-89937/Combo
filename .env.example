# FastAgentFactory local ROCm configuration.
# Runtime model calls are restricted to local/private endpoints; cloud model API credentials are unsupported.

# Optional profile overrides. Defaults are selected and persisted in the Local Models page.
AGENTFACTORY_MAIN_MODEL_PROFILE_ID=
AGENTFACTORY_TASK_MODEL_PROFILE_ID=
AGENTFACTORY_COMPRESSION_MODEL_PROFILE_ID=
AGENTFACTORY_EMBEDDING_MODEL_PROFILE_ID=

# Optional local endpoint overrides. Defaults are 127.0.0.1:8001/v1 and 127.0.0.1:8002.
AGENTFACTORY_LOCAL_INFERENCE_ENDPOINT=
AGENTFACTORY_LOCAL_INFERENCE_ALLOWED_HOSTS=
AGENTFACTORY_LOCAL_INFERENCE_TIMEOUT_SECONDS=

# Local Transformers embedding service.
AGENTFACTORY_LOCAL_EMBEDDING_ENDPOINT=
AGENTFACTORY_LOCAL_EMBEDDING_ALLOWED_HOSTS=
AGENTFACTORY_LOCAL_EMBEDDING_TIMEOUT_SECONDS=

# Optional per-role generation overrides. Empty values use the registered profile limits.
AGENTFACTORY_MAIN_MODEL_TEMPERATURE=
AGENTFACTORY_MAIN_MODEL_TIMEOUT_SECONDS=
AGENTFACTORY_MAIN_MODEL_MAX_OUTPUT_TOKENS=
AGENTFACTORY_TASK_MODEL_TEMPERATURE=
AGENTFACTORY_TASK_MODEL_TIMEOUT_SECONDS=
AGENTFACTORY_TASK_MODEL_MAX_OUTPUT_TOKENS=
AGENTFACTORY_COMPRESSION_MODEL_TEMPERATURE=
AGENTFACTORY_COMPRESSION_MODEL_TIMEOUT_SECONDS=
AGENTFACTORY_COMPRESSION_MODEL_MAX_OUTPUT_TOKENS=

# Context and memory policies.
AGENTFACTORY_MODEL_COMPRESSION_TRIGGER_TOKENS=
AGENTFACTORY_MEMORY_WRITE_INTERVAL_TURNS=

# Required to encrypt AgentPackage runtime resource values.
AGENTFACTORY_RESOURCE_MASTER_KEY=

# Competition mode disables automatic online MCP setup.
AGENTFACTORY_SKIP_WEB_SEARCH_MCP_SETUP=1
