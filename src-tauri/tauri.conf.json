{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "FastAgentFactory",
  "version": "0.1.5",
  "identifier": "com.fastagentfactory.app",
  "build": {
    "beforeDevCommand": "cd web_frontend/frontend && npm run dev",
    "beforeBuildCommand": "node scripts/prepare_tauri_resources.mjs && cd web_frontend/frontend && npx vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web_frontend/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FastAgentFactory",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python": "python",
      "resources/README.md": "README.md",
      "../agent_factory": "agent_factory",
      "../web_frontend/backend": "web_frontend/backend",
      "../web_frontend/frontend/dist": "web_frontend/dist",
      "../SystemPackage": "SystemPackage"
    },
    "externalBin": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "copyright": "Copyright (c) 2026 FastAgentFactory Team",
    "category": "DeveloperTool",
    "shortDescription": "AI Agent 工厂桌面应用",
    "longDescription": "FastAgentFactory 是一个跨平台的 AI Agent 开发与运行环境，使用本地进程逻辑隔离"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NUU0ODdCNTAxMDcwMTUKUldRVmNCQlFlMGhlUlY5ZXdHL0gxSThwT0RGdytxWWtaR2R5UFZKSGFTdE5WdlJsUHpFeTVtbnIK",
      "endpoints": [
        "https://liuyanai.top/api/v1/app-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": true
    }
  }
}
